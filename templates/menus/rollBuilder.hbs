<section id="rollBuilder" class="tab sidebar-tab directory flexcol roll-builder-sidebar active"
	style="flex-direction: column-reverse; position:absolute; bottom: 0;" data-tab="rollBuilder" data-group="primary">
	<header class="directory-header flexcol" data-application-part="header">
		<div class="header-actions action-buttons flexrow">
			<button type="button" class="roll-builder-print-to-chat" data-action="print">
				<i class="fa-solid fa-paste" inert=""></i>
				<span>Send</span>
			</button>
			<button type="button" class="roll-builder-roll-to-chat" data-action="roll">
				<i class="fa-solid fa-dice-d20" inert=""></i>
				<span>Roll</span>
			</button>
		</div>
	</header>
	<div class="flexcol roll-builder-options">
		<div class="flexrow roll-builder-row roll-builder-buttons">
			<button type="button" data-action="open-template-actor" title="Template Actor">
				<i class="fa-light fa-circle-user" inert=""></i>
			</button>
			<button type="button" data-action="open-global-actions" title="Global Roll Flags">
				<i class="fa-solid fa-flag" inert=""></i>
			</button>
			<button type="button" class="groupRollContainer" data-action="groupRoll" title="Group Roll Settings">
				<i class="fa-solid fa-user-group full-width" inert=""></i>
			</button>
			<button type="button" data-action="clearRoll" title="Clear">
				<i class="fa-solid fa-eraser" inert=""></i>
			</button>
		</div>
		<div class="flexrow roll-builder-row roll-builder-input-fields">
			<b class="fitwidth" style="padding: 0 1em;"><i class="fa-solid fa-dice-d20"></i></b>
			<div class="number-step flexrow">
				<button type="button" onclick="CONFIG.ui.rollBuilder.adjustRollData('bonusDice', -1)">-</button>
				<button type="button" onclick="CONFIG.ui.rollBuilder.adjustRollData('bonusDice', 1)">+</button>
			</div>
			<b class="fitwidth" style="padding: 0 1em;"><i class="fa-solid fa-plus-square"></i></b>
			<div class="number-step flexrow">
				<button type="button"
					onclick="CONFIG.ui.rollBuilder.adjustRollData('guaranteedSuccesses', -1)">-</button>
				<button type="button"
					onclick="CONFIG.ui.rollBuilder.adjustRollData('guaranteedSuccesses', 1)">+</button>
			</div>
		</div>
		<div class="flexrow roll-builder-row roll-builder-dc flex-group-center">
			<div class="flexrow flex-group-center">
				<b class="fitwidth" style="padding:0 0.5em;">DC</b>
				<div class="number-step flexrow">
					<button type="button" onclick="game.vrylGlobalFunctions.adjustNumberStepValue(this, -1)">-</button>
					<input type="number" id="dc-input" value='11' data-action="updateDC">
					<button type="button" onclick="game.vrylGlobalFunctions.adjustNumberStepValue(this, 1)">+</button>
				</div>
			</div>
			<div class="flexrow success-confidence">
				<div class="flexcol">
					<i>3 Successes: </i>
					<i>2 Successes: </i>
					<i>1 Successes: </i>
				</div>
				<div class="flexcol">
					<b id="3" class="success-confidence-estimate" title="75%"></b>
					<b id="2" class="success-confidence-estimate" title="75%"></b>
					<b id="1" class="success-confidence-estimate" title="75%"></b>
				</div>
			</div>
		</div>
	</div>
	<div class="flexcol roll-builder-attribute-container">

	</div>
</section>