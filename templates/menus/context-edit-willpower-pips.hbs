<div class="flexcol context-edit-willpower-pips">
    <b class="flex-group-center">Willpower</b>
    <div id="willpower" class="flex-group-center context-edit-willpower-pips">
            {{#for 0 maxLevel 1}}
            {{#if (lt index ../attribute.level)}}
            <i id="{{index}}" class="fa-solid fa-circle context-edit-willpower-pips attribute-level-pip-large"></i>
            {{else}}
            {{#if (lt index ../attribute.max)}}
            <i id="{{index}}"
                class="fa-regular fa-circle-dot context-edit-willpower-pips attribute-level-pip-large"></i>
            {{else}}
            <i id="{{index}}" class="fa-regular fa-circle context-edit-willpower-pips attribute-level-pip-large"></i>
            {{/if}}
            {{/if}}
            {{/for}}
    </div>
    <div class="flexcol">
        <div class="flexrow">
            <span >Current: </span>
            <span class="flex-group-center context-edit-willpower-pips">
                <i class="fa-solid fa-minus clickable context-edit-willpower-pips minus willpowerCurrent"></i>
                <i class="fa-solid fa-plus clickable context-edit-willpower-pips plus willpowerCurrent"
                    style="padding-left: 7px"></i>
            </span>
        </div>
        <div class="flexrow">
            <span class="">Level: </span>
            <span class="flex-group-center context-edit-willpower-pips">
                <i class="fa-solid fa-minus clickable context-edit-willpower-pips minus willpowerMax"></i>
                <i class="fa-solid fa-plus clickable context-edit-willpower-pips plus willpowerMax"
                    style="padding-left: 7px"></i>
            </span>
        </div>
    </div>
    <div class="flexrow">
        <span class="">Bonus: </span>
        <span id="willpower" class="flex-group-center attribute-bonus-dice context-edit-willpower-pips">
            <i class="fa-solid fa-minus clickable context-edit-willpower-pips minus willpower-bonus-dice"></i>
            <b><span class="bonus-dice-num">+0</span></b>
            <i class="fa-solid fa-plus clickable context-edit-willpower-pips plus willpower-bonus-dice" style="padding-left: 3px"></i>
        </span>
    </div>
</div>