<div class="flexcol">
    {{#each visibleTokens as |group|}}
    <div class="flexcol">
        {{!-- <b>{{@key}}</b> --}}
        {{#each group as |token|}}
        <div style="margin-right:auto;" class="flexrow flex-group-left centervert">
            <img src="{{actor.img}}" width="40px" style="margin-right:1em">
            <b class="clickable {{#if (includes ../../selectedActors token.id)}}selected{{/if}}"
                data-action="selectToken" id="{{token.id}}">
                {{token.name}}</b>
            {{!-- {{#if @root.doRender.activations}}
            <div class="flexrow centervert" style="margin-left:1em;">
                {{#for 0 token.actor.system.combat.maxActivations 1}}
                <i class="fa-solid fa-diamond centervert"></i>
                {{/for}}
            </div>
            {{/if}} --}}
        </div>
        {{/each}}
    </div>
    <hr>
    {{/each}}
</div>