<div class="flexcol">
    <div class="flexrow equipment-slot">
        <b style="flex: 3;" class="align-center flex-group-center">Name</b>
        <b style="flex: 1;" class="align-center flex-group-center">Slots</b>
        <i style="flex: 0.25;" class="align-center flex-group-center clickable fa-solid fa-plus" data-action="addSlot"></i>
    </div>
    {{#each equipmentSlots}}
    <div class="flexrow equipment-slot">
        <input style="flex: 3;" class="align-center flex-group-center" type="text" name="{{id}}" id="slotName" value="{{slotName}}">
        <input style="flex: 1;" class="align-center flex-group-center" name="{{id}}" type="number" id="slotSlots" value={{slotSlots}}>
        <i style="flex: 0.25;" class="align-center flex-group-center clickable fa-solid fa-trash-can" data-action="removeSlot" data-slot="{{id}}"></i>
    </div>
    {{/each}}
    <button type="submit">Confirm</button>
</div>