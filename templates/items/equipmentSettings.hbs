{{! Description Tab }}
<section style="max-height:fit-content;"
class="flexcol"
>
  {{#if editable}}
  <div class="flexrow">
    <b>Equipment Slot</b>
    <select id="equipSlotSelector" data-action="equipSlotChanged">
      <option value="" {{#if (eq system.equipment.slotDataName "")}}selected{{/if}}>Not Equippable</option>
      {{#each system.equipment.defaultSlotSettings as |slot|}}
        <option value="{{slot.dataName}}" {{#if (eq ../system.equipment.slotDataName slot.dataName)}}selected{{/if}}>{{slot.name}}</option>
      {{/each}}
    </select>
  </div>
  <div class="flexrow">
    <b>Slots Taken</b>
    <input id="equipSlotSlots" type="number" value="{{system.equipment.slotsFilled}}">
  </div>
  {{/if}}
</section>