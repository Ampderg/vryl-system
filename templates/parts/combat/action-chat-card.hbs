<div class="roll-builder-actor global">
    <div class="roll-builder-actor-inner flexcol flex-group-center">
        <h6 class="flex-group-center">{{name}}</h6>

        <span>{{{system.combatAction.actionPointString}}}</span>
        <div>
            {{{system.description}}}
        </div>
        {{#if flags.vryl.combatAction.targetNames}}
        <div class="flexcol flex-group-center">
            <b>Targets</b>
            {{#each flags.vryl.combatAction.targetNames}}
            <span>{{this}}</span>
            {{/each}}
        </div>
        {{/if}}

        {{#unless inSidebar}}
        {{#if system.combatAction.effects.length}}
        <button class="clickable" id="combatEffectsButton">Open Effects</button>
        {{/if}}
        {{/unless}}
    </div>
</div>