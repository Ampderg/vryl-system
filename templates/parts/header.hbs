<header class='sheet-header min-fit'>
  <div class="header-left-tab">
    <div>
      <img class='profile-img' src='{{img}}' data-tooltip='{{name}}' height='150' width='150' />
      <div class="profile-img-buttons">
        <i class="fa-solid fa-file-image" data-action='onEditImage'></i>
      </div>
    </div>
    {{#if actor.inCombat}}
    <div class="" style="margin-right:52px;">
      {{#if (eq (getGameVariable "combat.combatant.actor.uuid" ) actor.uuid)}}
      <button data-action="combatEndTurn">End Turn</button>
      {{/if}}
    </div>
    {{/if}}
  </div>
  <div class='header-fields'>
    <div class='document-name flexcol'>
      <input name='name' type='text' value='{{name}}' placeholder='Name' />
    </div>
</header>