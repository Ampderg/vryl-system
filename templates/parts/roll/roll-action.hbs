<div
    class="roll-builder-attribute roll-action flexcol flex-group-left align-left full-width" 
    data-action-data-name="{{action}}" data-actor-id="{{actorId}}">
    <!-- Narrative baseline features -->
    <span class="flex-group-left align-left full-width">
        <i>-
            {{#if (eq action "narrative-result")}}
            <b>Narrative Result</b>
            {{/if}}

            <!-- Roll Dice modification -->
            {{#if (eq action "roll-level-zero")}}
            <b title="When rolling 0 dice, instead roll 2 dice and suffer -1 Guaranteed Success.">"0 Dice" Rule</b>
            {{/if}}
            {{#if (eq action "explode-crits")}}
            <b title="Every 'Crit' grants a Bonus Die.">Exploding Crits</b>
            {{/if}}

            <!-- Combat -->
            {{#if (eq action "is-attack")}}
            This roll is an <b>Attack</b>
            {{/if}}
            {{#if (eq action "exposure")}}
            <b
                title="A number of Successes (that aren't already Crits) will be treated as if they rolled the highest possible die face, becoming Crits.">Exposure</b>
            {{/if}}

            <!-- Willpower -->
            {{#if (eq action "is-rest")}}
            This roll is a <b>Rest</b>
            {{/if}}
            {{#if (eq action "no-willpower-spend")}}
            You cannot spend Willpower to gain Guaranteed Successes
            {{/if}}
            {{#if (eq action "successes-regenerate-willpower")}}
            Regain one Willpower for every <b>Success</b>
            {{/if}}
            {{#if (eq action "failures-lose-willpower")}}
            Lose one Willpower for every <b>Failure</b>
            {{/if}}
            {{#if (eq action "condition-save")}}
            <b 
                title="Successes can be spent to clear Conditions of your choice.">Condition Save</b>
            {{/if}}

            <!-- Group Roll -->
            {{#if (eq action "group-roll")}}
            <b title="This roll's Level will be divided by the target group size before rolling.">Group Challenge</b>
            {{/if}}
        </i>
    </span>
    {{#each data.flags}}
    <span class='flexrow roll-action-flag' style="flex-wrap: nowrap;">
        <span>{{{settings.label}}}</span>

        <span>{{value}}</span>
        {{#if ../inSidebar}}
        {{#if settings.isAdjustable}}
            <button class="small-button" type="button"
                onclick="CONFIG.ui.rollBuilder.adjustRollFlagNumber(-1, '{{../action}}', '{{../actor}}', '{{flag}}', event)">-</button>
            <button class="small-button" type="button"
                onclick="CONFIG.ui.rollBuilder.adjustRollFlagNumber(1, '{{../action}}', '{{../actor}}', '{{flag}}', event)">+</button>
        {{/if}}
        {{/if}}

</span>
{{/each}}
</div>