<div class="roll-builder-prompt {{#if inSidebar}}inSidebar{{/if}} {{#if isApplied}}selected{{/if}} flexcol flex-group-center roll-item-uuid-{{uuid}}" 
{{#if inSidebar}}onclick="CONFIG.effectsFunctions.toggleEffectByUUID('{{uuid}}')"{{/if}}>
    <div class="inner flexcol" style="margin:0.5em;">
        <span><u><b>{{effect.parent.name}}</b>{{#unless (startsWith effect.name "Active Effect")}} - {{name}}{{/unless}}</u></span>
        <div class="flex-group-center" style="font-size:85%;">
            {{{effectDescription}}}
        </div>
    </div>
</div>