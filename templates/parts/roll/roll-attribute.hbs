<div class="roll-builder-attribute flexcol flex-group-center actor-{{actorId}} attribute-name-{{dataName}}">
    <b>{{name}}</b>
    {{#if hasLevel}}
    <span>{{combinedLevelWithoutBonus}}<i>{{bonusDiceString}}</i> <i class="fa-solid fa-dice-d20"></i></span>
    {{/if}}
    {{#if hasFlat}}
    <span>{{guaranteedSuccesses}} <i class="fa-solid fa-plus-square"></i></span>
    {{/if}}
</div>