<div>
    <hr>
    {{#eachAttribute system.attributeTypes}}
    <div id="{{dataName}}" class="attribute-type fitheight">
        <div class="flexrow fitheight">
            <b class="flex-group-center fitwidth typeOptions" style="max-width: 1.5em; writing-mode: vertical-lr;">{{name}}</b>
            {{#eachAttribute ../system.attributeCategories}}
            {{#if (eq typeDataName ../dataName)}}
            <div id="{{dataName}}" class="attribute-category flexcol">
                <b class="flex-group-center fitheight categoryOptions"><u>{{name}}</u></b>
                {{#each (sort (entries ../../system.attributes))}}
                {{#if this.exists}}
                {{#if (eq this.categoryDataName ../dataName)}}
                <div id="{{dataName}}" class="attribute flexrow fitheight {{#if indexOdd}}odd-row{{/if}}">
                    <span data-action="attribute-roll" id="{{dataName}}"
                        class="fitflex attribute-name clickable roll attribute-list 
                        actor-{{../../../actor.id}} attribute-type-{{../../dataName}} attribute-category-{{../dataName}} attribute-name-{{dataName}}">
                        {{name}}
                    </span>
                    {{#unless ../../../system.isTemplateActor}}
                    <span data-action="edit-attribute-pips" id="{{dataName}}"
                        class="fitwidth fitflex attribute-level clickable edit-attribute-pips attribute-list">
                        {{#for 0 ../../../system.maxLevel 1}}
                        {{#if (lt index ../this.combinedHeroicLevel)}}
                        <i class="fa-solid fa-plus-circle attribute-level-pip"></i>
                        {{else}}
                        {{#if (lt index ../this.combinedLevel)}}
                        <i class="fa-solid fa-circle attribute-level-pip"></i>
                        {{else}}
                        <i class="fa-regular fa-circle attribute-level-pip"></i>
                        {{/if}}
                        {{/if}}
                        {{/for}}
                        {{#nenull this.bonusDice 0}}
                        <span class="align-center" style="position:relative; font-size: 8px;"><i
                                style="position:absolute; bottom: 1em; left: 0.5em;"
                                class="fa-solid fa-asterisk align-center"></i></span>
                        {{/nenull}}
                    </span>
                    {{/unless}}
                </div>
                {{/if}}
                {{/if}}
                {{/each}}
            </div>
            {{/if}}
            {{/eachAttribute}}
        </div>
        <hr>
    </div>

    {{/eachAttribute}}
</div>